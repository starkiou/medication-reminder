# Récupérées dans Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Générées avec: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_SUBJECT=mailto:ton-email@example.com

# Optionnel : protège /api/cron contre les appels externes.
# Si défini, Vercel Cron envoie automatiquement ce secret dans l'en-tête Authorization.
CRON_SECRET=choisis-une-chaine-aleatoire
