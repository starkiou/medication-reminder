# ── Obligatoires ─────────────────────────────────────────────────────────────

# Récupérées dans Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Générées avec: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_SUBJECT=mailto:ton-email@example.com

# Code demandé une fois par l'application sur chaque appareil. Sans lui,
# personne ne peut lire ni modifier le suivi. Choisir une longue chaîne aléatoire.
ACCESS_CODE=choisis-une-longue-chaine-aleatoire

# Secret envoyé par le service de cron dans l'en-tête « Authorization: Bearer ... »
CRON_SECRET=choisis-une-autre-chaine-aleatoire

# ── Facultatives : réglages du suivi (valeurs par défaut indiquées) ──────────

# Nom du médicament. Absent, il n'apparaît ni dans l'interface ni dans les notifications.
# MED_NAME=
# Lignes de détail affichées sous le nom, séparées par « | »
# MED_DETAILS=
# Nom commun utilisé dans les phrases (« prends ton traitement »), et son genre
# MED_NOUN=traitement
# MED_NOUN_FEMININE=false

# Cycle : jours de prise, jours de pause (0 = prise continue), plaquettes par boîte
# PILL_DAYS=21
# PAUSE_DAYS=7
# PACKS_PER_BOX=3

# Heures des rappels dans le fuseau ci-dessous. BACKUP_HOUR=off désactive le rappel de secours.
# REMINDER_HOUR=21
# BACKUP_HOUR=22
# TIMEZONE=Europe/Paris
